
<!DOCTYPE html>
<html lang="ru">
{{> electrolysesHead}}
<body>
<div class="phone">
  <div class="screen screen--flush">
    <article class="chem-feed-card">
      <video
        class="chem-feed-video"
        src="{{item.vidSrc}}"
        poster="{{item.imgSrc}}"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>

      <div class="feed-bottom">
        <section class="feed-info">
          <h2>{{item.formula}}</h2>
          <p>{{item.name}}</p>

          {{#if item.anodeCathodeMassRatio}}
            <p>Соотношение массы анода к массе катода: {{item.anodeCathodeMassRatio}}</p>
          {{/if}}

          {{#if item.concentration}}
            <p>Концентрация: {{item.concentration}}%</p>
          {{/if}}
        </section>

        <div class="feed-actions">
          <button class="round-action" type="button" aria-label="В избранное">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.3 8.8c0 5-8.3 10-8.3 10s-8.3-5-8.3-10a4.5 4.5 0 018.3-2.4 4.5 4.5 0 018.3 2.4z"/>
            </svg>
          </button>

          <a
            class="round-action down-action"
            href="{{nextUrl}}"
            aria-label="Следующий элемент"
          >
            <svg viewBox="0 0 24 24">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </a>
        </div>
      </div>
    </article>
  </div>
  {{> electrolysesNav}}
</div>
</body>
</html>
