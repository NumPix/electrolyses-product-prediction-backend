
<!DOCTYPE html>
<html lang="ru">
{{> electrolysesHead}}
<body>
<div class="phone">
  <div class="screen add-screen">
    <form class="chem-form" action="/add" method="post" onsubmit="return false;">

      <input
        class="chem-input formula-input"
        type="text"
        name="formula"
        placeholder="Формула"
        value="{{draft.formula}}"
      />

      <div class="media-row">
        <button
          class="media-add"
          type="button"
          aria-label="Добавить изображение"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </button>

        <button
          class="media-add"
          type="button"
          aria-label="Добавить видео"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </button>
      </div>

      <input
        class="chem-input compound-name"
        type="text"
        name="name"
        placeholder="Название вещества"
        value="{{draft.name}}"
      />

      <input
        class="chem-input"
        type="number"
        name="anodeCathodeMassRatio"
        placeholder="Соотношение масс анода и катода"
        value="{{draft.anodeCathodeMassRatio}}"
        min="0"
        step="any"
      />

      <input
        class="chem-input"
        type="number"
        name="concentration"
        placeholder="Концентрация, %"
        value="{{draft.concentration}}"
        min="0"
        max="100"
        step="any"
      />

    </form>

    <div class="add-bar">
      <button type="button" class="add-button">Добавить</button>
    </div>
  </div>
  {{> electrolysesNav}}
</div>
</body>
</html>
