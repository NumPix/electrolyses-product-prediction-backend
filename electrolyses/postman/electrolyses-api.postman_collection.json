{
  "info": {
    "_postman_id": "eeda3006-1d3e-4676-ada5-328c025e5587",
    "name": "Electrolyses API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Услуги",
      "item": [
        {
          "name": "1. Список услуг (фильтр)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electrolyses?minAnodeCathodeMassRatio=5&maxAnodeCathodeMassRatio=10",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses"],
              "query": [
                {
                  "key": "minAnodeCathodeMassRatio",
                  "value": "5",
                  "description": "Соотношение массы анода к массе катода, от"
                },
                {
                  "key": "maxAnodeCathodeMassRatio",
                  "value": "10",
                  "description": "Соотношение массы анода к массе катода, до"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Лента без id (первая карточка)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electrolyses/feed",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "feed"]
            }
          },
          "response": []
        },
        {
          "name": "2. Лента по id (следующая)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electrolyses/feed/{{compoundId}}?next=true",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "feed", "{{compoundId}}"],
              "query": [
                {
                  "key": "next",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Получить черновик",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('compoundId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electrolyses/draft",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "draft"]
            }
          },
          "response": []
        },
        {
          "name": "4. Создать услугу (черновик + файлы)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('compoundId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "compoundName",
                  "value": "Сульфат натрия",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file"
                },
                {
                  "key": "video",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/electrolyses/draft",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "draft"]
            }
          },
          "response": []
        },
        {
          "name": "5. Опубликовать",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('compoundId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shortDescription\": \"Раствор сульфата натрия. При электролизе на катоде выделяется водород, на аноде — кислород.\",\n  \"anodeCathodeMassRatio\": 7.94,\n  \"concentrationPercent\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/electrolyses/draft",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "draft"]
            }
          },
          "response": []
        },
        {
          "name": "7. Лайк (like: 1 ставит, 0 снимает)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"like\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/electrolyses/{{compoundId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "{{compoundId}}", "like"]
            }
          },
          "response": []
        },
        {
          "name": "6. Удалить (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electrolyses/{{compoundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["electrolyses", "{{compoundId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
