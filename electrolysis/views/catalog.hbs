<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
<div class="phone">
  <div class="screen catalog-screen">
    <form class="filters" method="get" action="/electrolysis/catalog">
      <input
        type="number"
        class="filter"
        name="minMass"
        placeholder="Масса от, г"
        value="{{filters.minMass}}"
        min="0"
        step="any"
      />
      <input
        type="number"
        class="filter"
        name="maxMass"
        placeholder="Масса до, г"
        value="{{filters.maxMass}}"
        min="0"
        step="any"
      />
      <button type="submit" class="filter-btn" aria-label="Применить фильтр">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </form>

    {{#if error}}
      <p class="filter-error" role="alert">{{error}}</p>
    {{/if}}

    <div class="chem-grid">
      {{#each items}}
        <div class="chem-card-shell">
          <a
            class="chem-card {{#if this.tall}}chem-card--tall{{/if}}"
            href="/electrolysis/feed/{{this.id}}"
          >
            <div class="chem-card-image">
              <img
                src="{{this.imgSrc}}"
                alt="{{this.formula}}"
                loading="lazy"
                onerror="this.onerror=null; this.src='{{../placeholderImageUrl}}';"
              />
              {{#if this.mass}}
                <span class="mass-badge">{{this.mass}} г</span>
              {{/if}}
              <span class="likes-badge">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 21s-8-5.5-8-11a5 5 0 0110-1 5 5 0 0110 1c0 5.5-8 11-8 11z"/>
                </svg>
                {{this.likes}}
              </span>
            </div>
            <div class="chem-card-title">{{this.formula}}</div>
          </a>

          <form class="delete-form" action="/electrolysis/delete" method="post">
            <input type="hidden" name="compoundId" value="{{this.id}}" />
            <button type="submit" class="delete-button">Удалить</button>
          </form>
        </div>
      {{else}}
        <p class="chem-empty">Ничего не найдено</p>
      {{/each}}
    </div>
  </div>
  {{> nav}}
</div>
</body>
</html>
