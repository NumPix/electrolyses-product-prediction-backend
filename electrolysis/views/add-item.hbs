<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
<div class="phone">
  <div class="screen add-screen">
    <form
      class="chem-form"
      action="{{#if draft}}/electrolysis/publish{{else}}/electrolysis/draft{{/if}}"
      method="post"
    >
      <input
        class="chem-input formula-input"
        type="text"
        name="formula"
        placeholder="Формула электролита"
        value="{{draft.formula}}"
        required
        {{#if draft}}readonly{{/if}}
      />

      <div class="media-row">
        <div class="molecule-preview">
          <img
            src="{{#if draft}}{{draft.imgSrc}}{{else}}{{placeholderImageUrl}}{{/if}}"
            alt="Изображение раствора"
            onerror="this.onerror=null; this.src='{{placeholderImageUrl}}';"
          />
        </div>
        <div class="molecule-preview">
          <video
            src="{{#if draft}}{{draft.vidSrc}}{{else}}{{placeholderVideoUrl}}{{/if}}"
            poster="{{#if draft}}{{draft.imgSrc}}{{else}}{{placeholderImageUrl}}{{/if}}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            onerror="if (!this.dataset.fallbackApplied) { this.dataset.fallbackApplied = 'true'; this.src = '{{placeholderVideoUrl}}'; this.poster = '{{placeholderImageUrl}}'; this.load(); }"
          ></video>
        </div>
      </div>

      <input
        class="chem-input compound-name"
        type="text"
        name="name"
        placeholder="Название вещества"
        value="{{draft.name}}"
        required
        {{#if draft}}readonly{{/if}}
      />

      {{#if draft}}
        <textarea
          class="chem-input description-input"
          name="shortDescription"
          placeholder="Краткое описание раствора"
          required
        >{{draft.shortDescription}}</textarea>

        <input
          class="chem-input"
          type="number"
          name="mass"
          placeholder="Масса, г"
          value="{{draft.mass}}"
          min="0"
          step="any"
          required
        />

        <input
          class="chem-input"
          type="number"
          name="concentration"
          placeholder="Концентрация, %"
          value="{{draft.concentration}}"
          min="0"
          max="100"
          step="any"
          required
        />
      {{/if}}

      <div class="add-bar">
        {{#if draft}}
          <button type="submit" class="add-button">Опубликовать</button>
        {{else}}
          <button type="submit" class="add-button">Далее</button>
        {{/if}}
      </div>
    </form>
  </div>
  {{> nav}}
</div>
</body>
</html>
